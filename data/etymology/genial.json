{
  "word": "genial",
  "source": "https://en.wiktionary.org/wiki/genial",
  "etymologies": [
    {
      "heading": "Etymology 1",
      "paragraphs": [
        "Borrowed from Middle French génial, borrowed from Latin geniālis (“of or pertaining to marriage; festive”), from genius (“guardian spirit”) + -ālis."
      ],
      "senses": [
        "Friendly and cheerful; enlivening.",
        "(especially weather) Pleasantly mild and warm."
      ]
    },
    {
      "heading": "Etymology 2",
      "paragraphs": [
        "From Ancient Greek γένειον (géneion, “chin”) + -al."
      ],
      "senses": [
        "(anatomy) Relating to the chin; genian."
      ]
    }
  ]
}