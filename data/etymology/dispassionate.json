{
  "word": "dispassionate",
  "source": "https://en.wiktionary.org/wiki/dispassionate",
  "etymologies": [
    {
      "heading": "Etymology 1",
      "paragraphs": [
        "From dis- + passionate."
      ],
      "senses": [
        "Not showing, and not affected by, emotion, bias, or prejudice."
      ]
    },
    {
      "heading": "Etymology 2",
      "paragraphs": [
        "From dispassion + -ate (verb-forming suffix)."
      ],
      "senses": [
        "(obsolete, rare) To free from passion."
      ]
    }
  ]
}